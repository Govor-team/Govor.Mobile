<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0"/>
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0"/>
        <PackageReference Include="coverlet.collector" Version="6.0.4"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0"/>
        <PackageReference Include="NUnit" Version="4.3.2"/>
        <PackageReference Include="NUnit.Analyzers" Version="4.7.0"/>
        <PackageReference Include="NUnit3TestAdapter" Version="5.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="../Govor.Mobile/Services/Implementations/JwtServices/JwtProviderService.cs" Link="Production/JwtProviderService.cs"/>
        <Compile Include="../Govor.Mobile/Services/Interfaces/JwtServices/*.cs" Link="Production/%(Filename)%(Extension)"/>
        <Compile Include="../Govor.Mobile/Services/Interfaces/ServerIpProvader.cs" Link="Production/IServerIpProvider.cs"/>
        <Compile Include="../Govor.Mobile/Services/Api/Base/RefreshTokenHandler.cs" Link="Production/RefreshTokenHandler.cs"/>
        <Compile Include="../Govor.Mobile/Services/Api/Base/AuthHeaderHandler.cs" Link="Production/AuthHeaderHandler.cs"/>
        <Compile Include="../Govor.Mobile/Services/Api/Base/HttpRequestOptionsKeys.cs" Link="Production/HttpRequestOptionsKeys.cs"/>
        <Compile Include="../Govor.Mobile/Models/Responses/RefreshResponse.cs" Link="Production/RefreshResponse.cs"/>
        <Compile Include="../Govor.Mobile/Utilities/HubResult.cs" Link="Production/HubResult.cs"/>
        <Compile Include="../Govor.Mobile/Utilities/ChatDateFormatter.cs" Link="Production/ChatDateFormatter.cs"/>
        <Compile Include="../Govor.Mobile/Data/AccountDbContextFactory.cs" Link="Production/AccountDbContextFactory.cs"/>
        <Compile Include="../Govor.Mobile/Data/GovorDbContext.cs" Link="Production/GovorDbContext.cs"/>
        <Compile Include="../Govor.Mobile/Data/LocalMessage.cs" Link="Production/LocalMessage.cs"/>
        <Compile Include="../Govor.Mobile/Data/MessageView.cs" Link="Production/MessageView.cs"/>
        <Compile Include="../Govor.Mobile/Data/Configurations/LocalMessageConfiguration.cs" Link="Production/LocalMessageConfiguration.cs"/>
        <Compile Include="../Govor.Mobile/Services/Implementations/LocalAccountCache.cs" Link="Production/LocalAccountCache.cs"/>
        <Compile Include="../Govor.Mobile/Models/MediaFile.cs" Link="Production/MediaFile.cs"/>
        <Compile Include="../Govor.Mobile/Models/Requests/UploadMediaRequest.cs" Link="Production/UploadMediaRequest.cs"/>
        <Compile Include="../Govor.Mobile/Models/Responses/MessageReactionResponse.cs" Link="Production/MessageReactionResponse.cs"/>
        <Compile Include="../Govor.Mobile/Models/Responses/MessageResponse.cs" Link="Production/MessageResponse.cs"/>
        <Compile Include="../Govor.Mobile/Models/Responses/MessageViewResponse.cs" Link="Production/MessageViewResponse.cs"/>
        <Compile Include="../Govor.Mobile/Models/Responses/MediaAttachmentResponse.cs" Link="Production/MediaAttachmentResponse.cs"/>
        <Compile Include="../Govor.Mobile/Migrations/*.cs" Link="Production/Migrations/%(Filename)%(Extension)"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework"/>
    </ItemGroup>

</Project>
