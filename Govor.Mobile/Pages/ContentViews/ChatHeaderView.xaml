<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Govor.Mobile.Pages.ContentViews"
             xmlns:contentViewsModel="clr-namespace:Govor.Mobile.PageModels.ContentViewsModel"
             xmlns:mainModels="clr-namespace:Govor.Mobile.PageModels.MainFlow"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" xmlns:sho="http://sharpnado.com"
             x:Class="Govor.Mobile.Pages.ContentViews.ChatHeaderView"
             x:DataType="contentViewsModel:ChatHeaderViewModel">

    <Border
        Background="#11ffffff"
        StrokeShape="RoundRectangle 24"
        StrokeThickness="1"
        Stroke="#11ffffff"
        Padding="0,0">
        <sho:MaterialFrame
             MaterialTheme="AcrylicBlur"
             MaterialBlurStyle="Dark"
             AndroidBlurRadius="10"
             WinUIHostBackdropBlur="True"
             CornerRadius="24"
             Padding="8,4"
             Elevation="2">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <ImageButton
                x:Name="BackButton"
                Grid.Column="0"
                Source="back_icon.png"
                WidthRequest="38"
                HeightRequest="38"
                Padding="9"
                BackgroundColor="Transparent"
                Opacity="0.7"
                CornerRadius="19"
                Command="{Binding GoBackCommand}" />

            <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Grid Grid.Column="0" WidthRequest="48" HeightRequest="48">
                        <toolkit:AvatarView
                            HeightRequest="46"
                            WidthRequest="46"
                            CornerRadius="23"
                            BackgroundColor="{Binding Avatar.AvatarBackgroundColor}"
                            Text="{Binding Avatar.AvatarText}"
                            TextTransform="Uppercase"
                            FontSize="14"
                            FontAttributes="Bold"
                            FontFamily="CirilicOld"
                            ImageSource="{Binding Avatar.AvatarImage}"
                            BorderColor="#55FFFFFF"
                            Shadow="{Shadow Brush=Black, Offset='0,3', Radius=10, Opacity=0.2}"
                            BorderWidth="1">
                            <toolkit:AvatarView.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Avatar.OpenAvatarCommand}" />
                            </toolkit:AvatarView.GestureRecognizers>
                        </toolkit:AvatarView>

                        <Border
                        WidthRequest="12"
                        HeightRequest="12"
                        BackgroundColor="#43A25A"
                        Stroke="#281B172E"
                        StrokeThickness="2"
                        StrokeShape="Ellipse"
                        IsVisible="{Binding IsOnline}"
                        HorizontalOptions="End"
                        VerticalOptions="End" />
                </Grid>

                <VerticalStackLayout
                    Grid.Column="1"
                    VerticalOptions="Center"
                    Spacing="1">
                    <Label
                        Text="{Binding Title}"
                        TextColor="#FFFFFF"
                        FontSize="18"
                        FontFamily="CirilicOld"
                        FontAttributes="Bold"
                        LineBreakMode="TailTruncation"
                        MaxLines="1" />
                    <Label
                        x:Name="ProfileSubtitle"
                        Text="{Binding Subtitle}"
                        TextColor="#D4C9E3"
                        FontSize="11"
                        LineBreakMode="TailTruncation"
                        MaxLines="1" />
                    <Label x:Name="SelectionCount" x:DataType="mainModels:ChatPageModel"
                           Text="{Binding SelectedMessageCount, StringFormat='Выбрано: {0}'}"
                           TextColor="#D4C9E3" FontSize="11" IsVisible="False" />
                </VerticalStackLayout>
            </Grid>

            <HorizontalStackLayout x:Name="ProfileActions" Grid.Column="2" Spacing="2" VerticalOptions="Center">
                <ImageButton
                    Source="call_icon.png"
                    WidthRequest="36"
                    HeightRequest="36"
                    Padding="8"
                    BackgroundColor="Transparent"
                    IsVisible="{Binding IsGroup, Converter={StaticResource BoolInvertor}}"
                    Command="{Binding CallCommand}" />
                <Button
                    Text="Выйти"
                    FontSize="11"
                    Padding="8,0"
                    HeightRequest="32"
                    BackgroundColor="#351B172E"
                    TextColor="#F1E8FF"
                    IsVisible="{Binding IsGroup}"
                    Command="{Binding LeaveCommand}" />
                <Button
                    Text="⋯"
                    FontSize="24"
                    WidthRequest="36"
                    HeightRequest="36"
                    Padding="0"
                    BackgroundColor="Transparent"
                    TextColor="#FFFFFF"
                    Command="{Binding OpenMenuCommand}" />
            </HorizontalStackLayout>
            <HorizontalStackLayout x:Name="SelectionActions" x:DataType="mainModels:ChatPageModel"
                                   Grid.Column="2" Spacing="0" VerticalOptions="Center" IsVisible="False">
                <ImageButton Source="edit.png" WidthRequest="32" HeightRequest="38" Padding="7"
                             BackgroundColor="Transparent" IsVisible="{Binding CanEditMessage}"
                             Command="{Binding EditMessageCommand}" SemanticProperties.Description="Редактировать" />
                <ImageButton Source="copy.png" WidthRequest="32" HeightRequest="38" Padding="6"
                             BackgroundColor="Transparent" IsVisible="{Binding CanCopyMessages}"
                             Command="{Binding CopyMessagesCommand}" SemanticProperties.Description="Копировать" />
                <ImageButton Source="forward_message.png" WidthRequest="32" HeightRequest="38" Padding="6"
                             BackgroundColor="Transparent" IsVisible="{Binding CanForwardMessages}"
                             Command="{Binding ForwardMessagesCommand}" SemanticProperties.Description="Переслать" />
                <ImageButton Source="trash.png" WidthRequest="32" HeightRequest="38" Padding="7"
                             BackgroundColor="Transparent" IsVisible="{Binding CanDeleteMessages}"
                             Command="{Binding DeleteMessagesCommand}" SemanticProperties.Description="Удалить" />
            </HorizontalStackLayout>
        </Grid>
            </sho:MaterialFrame>
    </Border>
</ContentView>
