<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:markdown="clr-namespace:Govor.Markdown.Maui;assembly=Govor.Markdown.Maui">
    <Style x:Key="DefaultMarkdownStyle"
           TargetType="markdown:MarkdownView">
        
        <Setter Property="ImageHeight" Value="100" />

        <Setter Property="TextColor" Value="#D0FFFFFF" />
        <Setter Property="FontSize" Value="14" />

        <Setter Property="HeadingColor" Value="#6B50ED" />
        <Setter Property="CodeBackgroundColor" Value="#353b4d" />
        <Setter Property="HyperlinkColor" Value="#917EEC" />

    </Style>
</ResourceDictionary>
