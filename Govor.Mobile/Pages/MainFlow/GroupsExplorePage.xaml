<?xml version="1.0" ?>
<local:SmoothBackPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:Govor.Mobile.Pages" xmlns:vm="clr-namespace:Govor.Mobile.PageModels.MainFlow.Groups" xmlns:models="clr-namespace:Govor.Mobile.Models.Groups" xmlns:views="clr-namespace:Govor.Mobile.Pages.ContentViews" xmlns:glass="http://sharpnado.com" xmlns:pages="clr-namespace:Govor.Mobile.Pages.MainFlow" x:Class="Govor.Mobile.Pages.MainFlow.GroupsExplorePage" x:Name="Screen" x:DataType="vm:GroupsExploreModel" BackgroundColor="#10141F" SafeAreaEdges="None" Shell.NavBarIsVisible="False" ControlTemplate="{StaticResource MainPageTemplate}">
    <Grid RowDefinitions="Auto,*" Padding="12,0" RowSpacing="10" SafeAreaEdges="None">
        <Grid SafeAreaEdges="Container" Padding="0,6,0,0">
            <Border Style="{StaticResource ReactionGlassBorder}">
                <glass:MaterialFrame Style="{StaticResource ReactionGlassFrame}" Padding="0">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="6" ColumnSpacing="8">
                        <ImageButton Source="back_icon.png" Clicked="BackClicked" WidthRequest="40" HeightRequest="40" Padding="10" BackgroundColor="Transparent"/>
                        <Label Grid.Column="1" Text="Группы и каналы" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center"/>
                        <ActivityIndicator Grid.Column="2" WidthRequest="28" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#D9C7FF"/>
                    </Grid>
                </glass:MaterialFrame>
            </Border>
        </Grid>
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never" SafeAreaEdges="None">
            <VerticalStackLayout Spacing="12" Padding="0,0,0,30" IsEnabled="{Binding IsBusy, Converter={StaticResource BoolInvertor}}">
                <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}" Style="{StaticResource ReactionCaption}" Margin="4,0"/>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                    <Button Text="Поиск" Command="{Binding ShowSearchCommand}" Style="{StaticResource ReactionActionButton}"/>
                    <Button Text="Приглашение" Command="{Binding ShowInviteCommand}" Style="{StaticResource ReactionActionButton}" Grid.Column="1"/>
                    <Button Text="Создать" Command="{Binding ShowCreateCommand}" Style="{StaticResource ReactionActionButton}" Grid.Column="2"/>
                </Grid>
                <VerticalStackLayout IsVisible="{Binding IsSearch}" Spacing="12">
                    <Border Style="{StaticResource ReactionGlassBorder}">
                        <glass:MaterialFrame Style="{StaticResource ReactionGlassFrame}" Padding="0">
                            <VerticalStackLayout Margin="12" Spacing="8">
                                <SearchBar Text="{Binding Query}" MaxLength="100" Placeholder="Публичные группы и каналы" TextColor="White" PlaceholderColor="#CBC5D8" BackgroundColor="Transparent" SearchCommand="{Binding SearchCommand}"/>
                                <Button Text="Найти" Command="{Binding SearchCommand}" Style="{StaticResource ReactionActionButton}"/>
                            </VerticalStackLayout>
                        </glass:MaterialFrame>
                    </Border>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Results}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:GroupProfile">
                                <Border Style="{StaticResource ReactionGlassBorder}" Padding="12" Background="#402B3448">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference Screen}, Path=ViewModel.OpenCommand, x:DataType=pages:GroupsExplorePage}" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Name}" TextColor="White" FontSize="17" FontAttributes="Bold"/>
                                        <Label Text="{Binding Summary}" Style="{StaticResource ReactionCaption}"/>
                                        <Label Text="{Binding Description}" TextColor="#D5CDE0" MaxLines="2" LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="Ещё результаты" Command="{Binding MoreCommand}" Style="{StaticResource ReactionActionButton}" IsVisible="{Binding HasMore}"/>
                </VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding IsInvite}">
                    <Border Style="{StaticResource ReactionGlassBorder}">
                        <glass:MaterialFrame Style="{StaticResource ReactionGlassFrame}" Padding="0">
                            <VerticalStackLayout Margin="12" Spacing="8">
                                <Label Text="Ссылка или код приглашения" TextColor="White" FontAttributes="Bold"/>
                                <Entry Text="{Binding InvitationInput}" Placeholder="https://сервер/invite/код" TextColor="White" PlaceholderColor="#CBC5D8" BackgroundColor="Transparent"/>
                                <Button Text="Посмотреть сообщество" Command="{Binding PreviewInviteCommand}" Style="{StaticResource ReactionActionButton}"/>
                                <VerticalStackLayout IsVisible="{Binding HasPreview}" Spacing="8">
                                    <Label Text="{Binding InvitationPreview.Name}" TextColor="White" FontSize="20"/>
                                    <Label Text="{Binding InvitationPreview.Summary}" Style="{StaticResource ReactionCaption}"/>
                                    <Label Text="{Binding InvitationPreview.Description}" TextColor="#DDD5E8"/>
                                    <Button Text="Вступить" Command="{Binding JoinInviteCommand}" Style="{StaticResource ReactionActionButton}"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </glass:MaterialFrame>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding IsCreate}">
                    <Border Style="{StaticResource ReactionGlassBorder}">
                        <glass:MaterialFrame Style="{StaticResource ReactionGlassFrame}" Padding="0">
                            <VerticalStackLayout Margin="12" Spacing="8">
                                <Label Text="Новое сообщество" TextColor="White" FontSize="18" FontAttributes="Bold"/>
                                <Entry Text="{Binding CreateName}" MaxLength="100" Placeholder="Название" TextColor="White" PlaceholderColor="#CBC5D8" BackgroundColor="Transparent"/>
                                <Editor Text="{Binding CreateDescription}" MaxLength="500" Placeholder="Описание" TextColor="White" PlaceholderColor="#CBC5D8" BackgroundColor="Transparent" AutoSize="TextChanges" MinimumHeightRequest="80"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Приватное" TextColor="White" VerticalOptions="Center"/>
                                    <Switch Grid.Column="1" IsToggled="{Binding CreatePrivate}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Канал" TextColor="White" VerticalOptions="Center"/>
                                    <Switch Grid.Column="1" IsToggled="{Binding CreateChannel}"/>
                                </Grid>
                                <Label Text="В канале публикуют только владелец и администраторы. Тип сообщества после создания не меняется." Style="{StaticResource ReactionCaption}"/>
                                <Button Text="Создать сообщество" Command="{Binding CreateCommand}" Style="{StaticResource ReactionActionButton}"/>
                            </VerticalStackLayout>
                        </glass:MaterialFrame>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</local:SmoothBackPage>
