<?xml version="1.0" encoding="utf-8"?>

<local:SmoothBackPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Govor.Mobile.PageModels.ContentViewsModel.Messages"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:contentViews="clr-namespace:Govor.Mobile.Pages.ContentViews"
             xmlns:local="clr-namespace:Govor.Mobile.Pages"
             xmlns:markdown="clr-namespace:Indiko.Maui.Controls.Markdown;assembly=Indiko.Maui.Controls.Markdown"
             x:Class="Govor.Mobile.Pages.MainFlow.ChatPage"
             BackgroundColor="Transparent"
             ControlTemplate="{StaticResource MainPageTemplate}"
             Title="Chat"
             x:Name="chatpage"
             Shell.NavBarVisibilityAnimationEnabled="False"
             SafeAreaEdges="None"
             Padding="{OnPlatform iOS='0,0,0,0', Android='0'}">

    <Grid RowDefinitions="Auto,*,Auto" SafeAreaEdges="None" RowSpacing="0">

        <!-- HEADER -->
        <contentViews:ChatHeaderView
            SafeAreaEdges="All"
            Grid.Row="0"
            BindingContext="{Binding Header}"
            Margin="4,4,4,6" />

        <!-- CONTENT -->
        <Grid Grid.Row="1" Margin="0,-8,0,-11"  Padding="4,0" SafeAreaEdges="None" HorizontalOptions="Fill">
                <!-- MESSAGES -->
                <CollectionView
                    x:Name="CollectionView"
                    ItemsSource="{Binding MessageGroups}"
                    ItemsLayout="VerticalList"
                    SelectionMode="None"
                    ItemSizingStrategy="MeasureAllItems"
                    VerticalScrollBarVisibility="Never"
                    Margin="0,2">

                    <CollectionView.Footer>
                        <Grid HeightRequest="28" />
                    </CollectionView.Footer>

                    <CollectionView.Header>
                        <ActivityIndicator
                            IsVisible="{Binding IsLoadingMore}"
                            IsRunning="{Binding IsLoadingMore}"
                            Color="#D9C7FF"
                            Margin="0,12" />
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MessagesGroupModel">
                            <Grid Padding="8,5">

                                <!-- STACK MESSAGES -->
                                <VerticalStackLayout
                                    BindableLayout.ItemsSource="{Binding Messages}"
                                    Spacing="3">

                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MessagesViewModel">
                                            <VerticalStackLayout Spacing="2" HorizontalOptions="Fill">

                                                <VerticalStackLayout HorizontalOptions="{Binding BubbleAlignment}" Spacing="2">
                                                    <Border
                                                        Background="{Binding BubbleBackground}"
                                                        Stroke="#28FFFFFF"
                                                        StrokeThickness="1"
                                                        Padding="12,9"
                                                        HorizontalOptions="{Binding BubbleAlignment}">

                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="{Binding BubbleCorners}" />
                                                        </Border.StrokeShape>

                                                        <Border.Shadow>
                                                            <Shadow Brush="#70000000" Offset="0,3" Radius="8" Opacity="0.22" />
                                                        </Border.Shadow>

                                                        <Grid RowDefinitions="Auto,Auto" RowSpacing="5">
                                                            <markdown:MarkdownView
                                                                MaximumWidthRequest="310"
                                                                MinimumWidthRequest="42"
                                                                HyperlinkColor="#6394B7"
                                                                OnHyperLinkClicked="MarkdownView_OnHyperLinkClicked"
                                                                TextColor="#F5F0FF"
                                                                MarkdownText="{Binding Text}" />

                                                            <!-- Время внутри тела сообщения -->
                                                            <Label
                                                                Grid.Row="1"
                                                                Text="{Binding Time}"
                                                                FontSize="9"
                                                                TextColor="#BFB4D2"
                                                                VerticalOptions="End"
                                                                HorizontalOptions="{Binding BubbleAlignment}"
                                                                Margin="0,0,1,0" />
                                                        </Grid>
            
                                                    </Border>

                                                    <!-- Avatar under the last message in a group (time moved into bubble) -->
                                                    <HorizontalStackLayout IsVisible="{Binding ShowAvatar}"  Spacing="6">
                                                        <toolkit:AvatarView
                                                            HeightRequest="26"
                                                            WidthRequest="26"
                                                            BorderColor="Transparent"
                                                            CornerRadius="20"
                                                            HorizontalOptions="{Binding BubbleAlignment}"
                                                            BackgroundColor="{Binding Avatar.AvatarBackgroundColor}"
                                                            Text="{Binding Avatar.AvatarText}"
                                                            ImageSource="{Binding Avatar.AvatarImage}" />
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>

                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>

                                </VerticalStackLayout>

                            </Grid>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <Label
                            Text="Начните диалог 👋"
                            TextColor="MediumPurple"
                            FontAttributes="Bold"
                            FontSize="25"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                             />
                    </CollectionView.EmptyView>
                </CollectionView>

            <!-- Floating scroll-to-bottom button -->
            <Button
                x:Name="ScrollToEndButton"
                IsVisible="False"
                Clicked="ScrollToBottomButton_Clicked"
                Text="↓"
                FontSize="20"
                WidthRequest="44"
                HeightRequest="44"
                CornerRadius="22"
                BackgroundColor="#B33E315B"
                TextColor="#F5EFFF"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="12,12,12,12"
                Opacity="0.95" />

        </Grid>

        <!-- INPUT -->
        <Grid Grid.Row="2"
              SafeAreaEdges="SoftInput"
              Margin="12,6,12,12"
              InputTransparent="False">
                <Border
                    Background="#661B172E"
                    Stroke="#55E6D8FF"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    Padding="10,6">
                    <Border.Shadow>
                        <Shadow Brush="#90000000" Offset="0,4" Radius="12" Opacity="0.35" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">

                        <Editor
                            x:Name="MessageEditor"
                            Text="{Binding MessageText}"
                            Placeholder="Сообщение..."
                            TextColor="White"
                            PlaceholderColor="#B5A9C5"
                            AutoSize="TextChanges"
                            MaximumHeightRequest="140"
                            MinimumHeightRequest="38"
                            BackgroundColor="Transparent"
                            Margin="0,0,8,0" />

                        <Button Grid.Column="1"
                                VerticalOptions="End"
                                Command="{Binding SendMessageCommand}"
                                Clicked="SendMessageButtonClicked"
                                Text="➤"
                                FontSize="20"
                                WidthRequest="42"
                                HeightRequest="42"
                                CornerRadius="21"
                                BackgroundColor="#995F4BB7"
                                TextColor="#FFFFFF"
                                Padding="0" />
                    </Grid>
                </Border>
        </Grid>
    </Grid>
</local:SmoothBackPage>